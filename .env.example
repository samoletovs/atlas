# Candidate API settings; parent promotion gate and +$10/month pilot apply.
FOUNDRY_AOAI_ENDPOINT=https://foundrylab-aiservices.cognitiveservices.azure.com/
FOUNDRY_DEPLOYMENT=gpt-6-luna
FOUNDRY_MODEL=gpt-6-luna
FOUNDRY_LESSON_DEPLOYMENT=gpt-6-sol
FOUNDRY_LESSON_MODEL=gpt-6-sol
FOUNDRY_API_VERSION=2024-10-21
# Preserve the existing per-instance ceiling; this is not a fleet/monthly cap.
ATLAS_DAILY_BUDGET_USD=5.00
# Durable shared Sol admission. Lower or set 0 to disable; values above 0.10 fail.
ATLAS_SOL_DAILY_BUDGET_USD=0.10

# Scheduled planner/teacher/enhancer agents are NOT the API model path.
FOUNDRY_PROJECT_ENDPOINT=https://foundrylab-aiservices.services.ai.azure.com/api/projects/foundrylab
FOUNDRY_AGENT_DEPLOYMENT=gpt-4o-mini
COSMOS_ENDPOINT=
COSMOS_DATABASE=atlas
