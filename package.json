{
  "name": "atlas",
  "version": "1.0.0",
  "description": "atlas — personal teacher PWA",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "echo \"No linter configured yet\"",
    "test": "playwright test",
    "test:typecheck": "tsc --project tsconfig.tests.json",
    "test:portal": "playwright test learningPortal.spec.ts learningRefinements.spec.ts supportFlows.spec.ts visualRefinements.spec.ts adaptiveScoring.spec.ts relatedTopics.spec.ts recentlyRead.spec.ts apiRoutes.spec.ts",
    "test:pwa": "playwright test --config playwright.pwa.config.ts",
    "test:install": "playwright install chromium --with-deps"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.1.1"
  }
}
